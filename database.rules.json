{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && data.child('meta/host').val() === auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)"
        },
        "seats": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid",
          "$i": {
            ".write": "auth != null && ((data.child('kind').val() === 'open' && !data.child('uid').exists() && newData.child('uid').val() === auth.uid && newData.child('kind').val() === 'human') || (data.child('uid').val() === auth.uid && newData.child('kind').val() === 'open' && !newData.child('uid').exists()))"
          }
        },
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid"
        },
        "fx": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid"
        },
        "host": {
          ".read": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid"
        },
        "priv": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid"
          }
        },
        "intents": {
          ".read": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid",
          ".write": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
          }
        }
      }
    }
  }
}